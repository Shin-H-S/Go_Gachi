# ====================================================================
# 5. AI / DEEP LEARNING MODELS & DATA (대용량 파일 배제) 🤖
# ====================================================================
# 대용량 가중치 파일 확장자 (Git LFS 미사용 시 필수 방어)
*.pt
*.pth
*.safetensors
*.onnx
*.h5
*.bin
*.ckpt
*.pb

# 대용량 로컬 데이터셋 및 모델 저장 폴더 구조 명시
/backend/app/ml/models/
/backend/app/ml/weights/
/data/
/dataset/
/outputs/

# 백엔드 업로드/결과 폴더: 폴더 구조(.gitkeep)는 유지하되 내용물(이미지)은 커밋 금지
/backend/uploads/*
!/backend/uploads/.gitkeep
/backend/outputs/*
!/backend/outputs/.gitkeep
# 백엔드 SQLite DB 폴더: app.db는 커밋 금지(폴더 구조만 유지)
/backend/data/*
!/backend/data/.gitkeep

# Prompt engineering local references
/docs/prompt-references/
/docs/superpowers/

# Prompt experiment outputs: generated images and run artifacts stay local.
/experiments/runs/

# Jupyter Notebook 캐시
.ipynb_checkpoints

