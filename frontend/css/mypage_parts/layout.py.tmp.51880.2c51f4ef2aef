MYPAGE_LAYOUT_CSS = """
.st-key-mypage-shell,
.mypage-shell {
    display: block;
    min-height: calc(100vh - 48px);
}

.main .block-container:has(.st-key-mypage-shell),
[data-testid="stMainBlockContainer"]:has(.st-key-mypage-shell) {
    max-width: none;
    padding-top: 0;
    padding-left: 0;
}

.st-key-mypage-shell [data-testid="stColumn"]:not(:has(.mypage-sidebar-head)) {
    box-sizing: border-box;
    padding-top: 12px;
}

.st-key-mypage-shell [data-testid="stColumn"]:has(.mypage-sidebar-head) {
    background: #ffffff !important;
    background-color: #ffffff !important;
    align-self: stretch !important;
    position: relative;
}

.st-key-mypage-shell [data-testid="stColumn"]:has(.mypage-sidebar-head) > div,
.st-key-mypage-shell
    [data-testid="stColumn"]:has(.mypage-sidebar-head)
    [data-testid="stVerticalBlock"],
.st-key-mypage-shell
    [data-testid="stColumn"]:has(.mypage-sidebar-head)
    [data-testid="stVerticalBlockBorderWrapper"] {
    background: #ffffff !important;
    background-color: #ffffff !important;
}

.mypage-sidebar-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 14px 22px;
    border-bottom: 1px solid #e5e2da;
    margin-bottom: 18px;
}

.mypage-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #232b2a;
    color: #ffffff;
    font-weight: 800;
}

.mypage-sidebar-head strong {
    display: block;
    color: #151a19;
    font-size: 17px;
    line-height: 1.25;
}

.mypage-sidebar-head small {
    display: block;
    margin-top: 4px;
    color: #717b77;
    font-size: 12px;
    overflow-wrap: anywhere;
}

.mypage-title {
    margin: 0 0 26px !important;
    color: #131817;
    font-size: 34px !important;
    line-height: 1.1 !important;
}
"""
