# 로컬 실행: 이 파일을 레포 최상단 .env로 복사해서 사용.
# 실제 시크릿은 git에 올리지 않고 1Password / DM으로 공유.
# Render / Streamlit Cloud 배포 시엔 각 서비스의 환경변수 UI로 주입.

APP_ENV=production
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Frontend -> Backend 연결.
# 같은 서버에서 FastAPI(8000)와 Streamlit(8501)을 같이 띄우면 기본값 그대로 사용.
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=*
# 화면 목업만 확인할 때 true, 실제 생성 테스트는 false
FRONTEND_USE_MOCK=false
# auto(백엔드 우선, 실패 시 로컬) | backend | local
FRONTEND_CONFIG_SOURCE=auto

# DB — Supabase Postgres. 실제 URL은 git에 올리지 않고 1Password/DM 공유.
# 로컬: Session pooler URL (IPv4 호환)
# Render: Supabase Transaction pooler URL 권장
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Supabase Auth. JWT_SECRET 없으면 보호 라우트(/api/auth/me 등) 503 반환.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ_REPLACE_WITH_ANON_KEY
SUPABASE_JWT_SECRET=replace_with_legacy_jwt_secret

# 외부 스토리지 — Cloudflare R2 (S3 호환).
# STORAGE_BACKEND=local: backend/uploads, backend/outputs에 로컬 저장
# STORAGE_BACKEND=r2:    Cloudflare R2 버킷 사용
STORAGE_BACKEND=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# 비용 추적.
# OPENAI_ADMIN_KEY가 있으면 /api/internal/usage에 실제 월간 비용(actual_*) 추가 표시.
OPENAI_IMAGE_EDIT_ESTIMATED_COST_USD=0.01
OPENAI_BUDGET_LIMIT_USD=30.0
OPENAI_BUDGET_ALERT_USD=25.0

# (보통 안 건드림) 저장 폴더. 컨테이너 임시 저장이 필요하면 /tmp/... 로 변경.
# STORAGE_BACKEND=r2면 uploads/outputs는 사용 안 함.
# DATA_DIR=./backend/data
# UPLOAD_DIR=./backend/uploads
# OUTPUT_DIR=./backend/outputs

# 참고: 프롬프트 버전은 backend/app/core/prompts.py의 PROMPT_VERSION 상수에서 관리.
