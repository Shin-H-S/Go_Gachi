# Runtime variable reference for Cloud Run / Cloud Build.
# 로컬 검증 시 이 파일을 레포 최상단 `.env`로 복사해서 프론트/백엔드 공통 기준으로 사용한다.
# OPENAI_API_KEY / OPENAI_ADMIN_KEY should be injected from Secret Manager, not committed.
APP_ENV=production
IMAGE_PROVIDER=openai
OPENAI_API_KEY=secret-manager:OPENAI_API_KEY
OPENAI_ADMIN_KEY=secret-manager:OPENAI_ADMIN_KEY
OPENAI_TEXT_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Frontend -> Backend 연결.
# 같은 서버에서 FastAPI(8080)와 Streamlit(8501)을 같이 띄우면 기본값 그대로 사용.
BACKEND_URL=http://127.0.0.1:8080
# 화면 목업만 확인할 때만 true. 실제 생성 테스트에서는 false로 둔다.
FRONTEND_USE_MOCK=false
# 프론트 프리셋 소스: auto(백엔드 우선, 실패 시 로컬), backend, local.
FRONTEND_CONFIG_SOURCE=auto

# DB — 외부 Postgres (Supabase) 사용. 실제 URL은 git에 올리지 않고 1Password/DM으로 공유할 예정
# 로컬 개발은 Supabase의 "Session pooler" URL 권장 (IPv4 호환).
# Cloud Run 배포 시에는 "Transaction pooler" URL 사용.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# (선택) 인터넷 없이 완전 로컬에서 돌릴 때만 SQLite로 폴백 가능.
# DATABASE_URL=sqlite+aiosqlite:///./backend/data/app.db

# 비용 추적:
# - OPENAI_IMAGE_EDIT_ESTIMATED_COST_USD: 우리 앱 요청 1건당 내부 추정 비용
# - remaining은 항상 우리 앱 내부 추정 비용 기준으로 계산
# - OPENAI_ADMIN_KEY가 있으면 /api/internal/usage에 OpenAI 실제 월간 비용(actual_*)을 추가로 표시
OPENAI_IMAGE_EDIT_ESTIMATED_COST_USD=0.01
OPENAI_BUDGET_LIMIT_USD=30.0
OPENAI_BUDGET_ALERT_USD=25.0

# (보통은 건드릴 일 없음) DB 파일/원본 업로드/결과 PNG가 저장될 폴더.
# 기본적으로 backend/data, backend/uploads, backend/outputs 에 저장됨. 평소엔 그대로 둬도 됨.
# Cloud Run에 올릴 때만 /tmp/... 같은 경로로 바꿔서 켠다.
# DATA_DIR=./backend/data
# UPLOAD_DIR=./backend/uploads
# OUTPUT_DIR=./backend/outputs
# 참고: 프롬프트 버전은 backend/app/core/prompts.py 의 PROMPT_VERSION 상수에서 관리.
