# ============================================================
# 환경변수 양식 (템플릿)
# ------------------------------------------------------------
# 사용법:
#   1) 이 파일을 복사해서 같은 폴더에 ".env" 로 만든다
#         (PowerShell)  Copy-Item .env.example .env
#   2) .env 안의 값들을 본인 것으로 채운다
#   3) .env 는 절대 git 에 올리지 않는다 (이미 .gitignore 처리됨)
# ============================================================

# ===== OpenAI (필수) =====
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-여기에_본인_키_붙여넣기

# ===== MySQL (Docker) — 필수 =====
# docker-compose 와 backend 가 함께 사용. 비밀번호는 본인 값으로.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=go_gachi

# ===== CORS (선택) =====
# 프론트엔드 개발 서버 주소. 기본값 http://localhost:3000
# CORS_ORIGINS=["http://localhost:3000"]

# ===== LangSmith (선택, LangChain 추적용) =====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
